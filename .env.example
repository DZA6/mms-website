# =============================================================================
# Memorial Media Services — Environment Configuration
# =============================================================================
# Copy this template. Set values for production.
# NOTE: On PythonAnywhere, these go in the Web tab → "Environment variables"
# section — NOT in a .env file on the server.

# --- Django (REQUIRED) ---
# Generate a fresh key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=www.yourdomain.com,yourdomain.com

# --- Contact Info ---
CONTACT_PHONE=(661) 271-2148
CONTACT_EMAIL=MMSantelopevalley@gmail.com

# --- Site URL (for email links and Stripe) ---
SITE_URL=https://www.yourdomain.com

# --- Stripe (REQUIRED — use LIVE keys) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Analytics (optional) ---
GOOGLE_ANALYTICS_ID=G-YVSQJ9SE13

# --- Database (optional — leave blank for SQLite) ---
# Set to a PostgreSQL URL when you upgrade to the Web plan:
# DATABASE_URL=postgres://user:password@host:5432/dbname
